+    def _saida_exige_buffer(self) -> bool:
+        """Em REDACT/BLOCK a saída só pode sair depois de varrida.
+
+        Patch N17: o upstream entregava os tokens antes de varrer e só
+        alertava no fim ("post-hoc"), então REDACT e BLOCK não valiam para
+        respostas em streaming. Agora, nesses modos, a resposta é acumulada,
+        varrida e só então liberada (perde-se o efeito "token a token").
+        """
+        return self._scan_output and self._mode in (
+            RedactionMode.REDACT,
+            RedactionMode.BLOCK,
+        )
