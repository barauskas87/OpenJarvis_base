+    # Patch N24: tentativas para falhas transitórias do gateway.
+    _TENTATIVAS = 3
+    _CODIGOS_TRANSITORIOS = frozenset({429, 502, 503, 504})
+    _dormir = staticmethod(time.sleep)
+
+    def _pausa_para_retry(self, resp: httpx.Response, tentativa: int) -> float:
+        """Segundos de espera: ``Retry-After`` (máx. 30 s) ou 0,5·2^n."""
+        cabecalho = resp.headers.get("retry-after", "")
+        try:
+            return min(30.0, max(0.0, float(cabecalho)))
+        except ValueError:
+            return 0.5 * (2**tentativa)
+
+    def _postar(self, url: str, payload: Dict[str, Any]) -> httpx.Response:
+        """POST com retry de falhas transitórias e remoção segura de ``tools``."""
+        retirou_tools = False
+        for tentativa in range(self._TENTATIVAS + 1):
+            resp = self._client.post(url, json=payload)
+            if resp.status_code in self._CODIGOS_TRANSITORIOS and (
+                tentativa < self._TENTATIVAS
+            ):
+                self._dormir(self._pausa_para_retry(resp, tentativa))
+                continue
+            # Só repete SEM ferramentas se o corpo do erro fala delas; o upstream
+            # repetia em qualquer 400 e escondia outros erros.
+            if (
+                resp.status_code == 400
+                and "tools" in payload
+                and not retirou_tools
+                and any(p in resp.text.lower() for p in ("tool", "function"))
+            ):
+                payload = {
+                    k: v
+                    for k, v in payload.items()
+                    if k not in ("tools", "tool_choice")
+                }
+                retirou_tools = True
+                logger.warning(
+                    "%s rejeitou 'tools'; repetindo sem ferramentas", self.engine_id
+                )
+                continue
+            return resp
+        return resp  # pragma: no cover — o laço sempre retorna antes
 
