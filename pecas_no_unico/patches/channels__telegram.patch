+    @staticmethod
+    def _parse_ids(valor: Union[str, Iterable[Union[str, int]]]) -> frozenset:
+        """Aceita "1,2,3" ou uma lista de ids; devolve um conjunto de textos."""
+        if isinstance(valor, str):
+            partes = valor.split(",")
+        else:
+            partes = list(valor or [])
+        return frozenset(str(p).strip() for p in partes if str(p).strip())
+
+    def autorizado(self, user_id: str, chat_id: str) -> bool:
+        """True se o USUÁRIO está na lista (e o chat, se houver lista de chats)."""
+        if not user_id or user_id not in self._allowed_user_ids:
+            return False
+        if self._allowed_chat_ids and chat_id not in self._allowed_chat_ids:
+            return False
+        return True
+
+    def _sem_token(self, texto: object) -> str:
+        """Remove o token de qualquer texto que vá para log."""
+        saida = str(texto)
+        return saida.replace(self._token, "[token]") if self._token else saida
