+    async def _tratar_update(self, update: Any) -> None:
+        """Autoriza e despacha uma mensagem recebida (fora do loop do PTB).
+
+        Patch N22: o handler do agente (chamada de modelo, possivelmente minutos)
+        roda num ``ThreadPoolExecutor``; no upstream rodava dentro do loop do
+        PTB e travava o bot inteiro. O retorno do handler, se for texto, é
+        enviado como resposta (no upstream era ignorado).
+        """
+        msg = getattr(update, "message", None)
+        if msg is None:
+            return
+        user_id = str(msg.from_user.id) if getattr(msg, "from_user", None) else ""
+        chat_id = str(msg.chat.id)
+        if not self.autorizado(user_id, chat_id):
+            # Não registra o conteúdo nem o nome: só que houve tentativa.
+            logger.debug("Telegram: mensagem de usuário não autorizado ignorada")
+            return
+        cm = ChannelMessage(
+            channel="telegram",
+            sender=user_id,
+            content=msg.text or "",
+            message_id=str(msg.message_id),
+            conversation_id=chat_id,
+        )
+        pool = self._pool
+        if pool is None:
+            return
+        loop = asyncio.get_running_loop()
+        await loop.run_in_executor(pool, self._despachar, cm)
+
+    def _despachar(self, cm: ChannelMessage) -> None:
+        """Entrega a mensagem aos handlers e responde com o texto devolvido."""
+        for handler in list(self._handlers):
+            try:
+                resposta = handler(cm)
+            except Exception:  # noqa: BLE001
+                logger.exception("Telegram handler error")
+                continue
+            if isinstance(resposta, str) and resposta.strip():
+                self.send(cm.conversation_id, resposta, conversation_id=cm.message_id)
+        if self._bus is not None:
+            self._bus.publish(
+                EventType.CHANNEL_MESSAGE_RECEIVED,
+                {
+                    "channel": cm.channel,
+                    "sender": cm.sender,
+                    "content": cm.content,
+                    "message_id": cm.message_id,
+                },
+            )
+
