+# Patch N20: o servidor MCP (processo de terceiros) recebe SÓ estas variáveis,
+# mais as que o chamador listar em ``env_extra``. O upstream herdava o
+# ambiente inteiro (chaves de API incluídas).
+_ENV_BASE = ("PATH", "HOME", "USER", "LANG", "TERM")
+_ENV_WINDOWS = (
+    "SystemRoot",
+    "SystemDrive",
+    "COMSPEC",
+    "PATHEXT",
+    "TEMP",
+    "TMP",
+    "USERPROFILE",
+    "LOCALAPPDATA",
+    "APPDATA",
+)
+
+
+def montar_env_minimo(env_extra: Optional[dict] = None) -> dict:
+    """Ambiente mínimo para o subprocesso MCP (+ variáveis explícitas)."""
+    chaves = _ENV_BASE + (_ENV_WINDOWS if os.name == "nt" else ())
+    env = {k: os.environ[k] for k in chaves if k in os.environ}
+    for chave, valor in (env_extra or {}).items():
+        env[str(chave)] = str(valor)
+    return env
+
 
 class MCPTransport(ABC):
     """Abstract transport layer for MCP communication."""
