<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de tráfego em claro; só autoridades do sistema (o certificado fixo do Nó
     é tratado dentro do app, por ConfiancaTls). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
